# Copy to .env and fill in. NEVER commit .env.

# ---------- LLM (provider-agnostic, "provider:model") ----------
# Examples:
#   anthropic:claude-sonnet-5-5
#   openai:<model-name>
#   ollama:llama3.1
LLM_MODEL=anthropic:claude-sonnet-5-5
LLM_TEMPERATURE=0.2
# Vision-language model for chart/figure parsing (Week 3)
VLM_MODEL=ollama:llava

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# ---------- Embeddings ----------
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384

# ---------- Milvus (docker compose up -d) ----------
MILVUS_URI=http://localhost:19530
MILVUS_COLLECTION=papers

# ---------- Literature APIs ----------
# NCBI requires an email; an API key raises the rate limit (3 -> 10 req/s)
NCBI_EMAIL=
NCBI_API_KEY=
ARXIV_CATEGORIES=cs.LG,cs.AI,q-bio.QM
INGEST_MAX_RESULTS=50

# ---------- Sandbox ----------
SANDBOX_IMAGE=discovery-sandbox:latest
SANDBOX_TIMEOUT_S=120
SANDBOX_MEM_LIMIT=2g
SANDBOX_CPUS=1.0

# ---------- Agent loop ----------
MAX_DEBUG_ITERATIONS=5
RUNS_DIR=runs
CHECKPOINT_DB=checkpoints/graph.sqlite
